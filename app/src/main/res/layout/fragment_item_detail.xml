<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Vùng nội dung cuộn được -->
    <ScrollView
        android:id="@+id/scrollViewDetail"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnContactOwner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Ảnh đồ vật -->
            <ImageView
                android:id="@+id/imgItemDetail"
                android:layout_width="0dp"
                android:layout_height="250dp"
                android:background="#E0E0E0"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_gallery"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Nút quay lại ở góc trên bên trái ảnh -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Quay lại"
                android:padding="12dp"
                android:src="@android:drawable/ic_media_previous"
                android:tint="#B71C1C"
                app:layout_constraintStart_toStartOf="@id/imgItemDetail"
                app:layout_constraintTop_toTopOf="@id/imgItemDetail" />

            <!-- Thẻ trạng thái ở góc dưới bên phải ảnh -->
            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:background="#4CAF50"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="Đang tìm"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/imgItemDetail"
                app:layout_constraintEnd_toEndOf="@id/imgItemDetail" />

            <!-- Tên đồ vật -->
            <TextView
                android:id="@+id/tvDetailTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:text="Ví da nam màu đen"
                android:textColor="#000000"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/imgItemDetail"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Địa điểm -->
            <TextView
                android:id="@+id/tvDetailLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:text="📍 Địa điểm: Tòa F.04.05 cơ sở 3"
                android:textColor="#555555"
                android:textSize="16sp"
                app:layout_constraintTop_toBottomOf="@id/tvDetailTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Đường phân cách -->
            <View
                android:id="@+id/dividerDetail"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_margin="16dp"
                android:background="#DDDDDD"
                app:layout_constraintTop_toBottomOf="@id/tvDetailLocation"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Tiêu đề mô tả -->
            <TextView
                android:id="@+id/tvDescLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:text="Mô tả chi tiết:"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/dividerDetail"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Nội dung mô tả -->
            <TextView
                android:id="@+id/tvDetailDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:lineSpacingExtra="4dp"
                android:text="Bên trong có thẻ sinh viên, một ít tiền mặt và thẻ giữ xe. Ai nhặt được xin liên hệ nhận hậu tạ!"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvDescLabel"
                app:layout_constraintVertical_bias="0.03" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- Nút liên hệ cố định ở đáy màn hình -->
    <Button
        android:id="@+id/btnContactOwner"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_margin="16dp"
        android:backgroundTint="#B71C1C"
        android:text="LIÊN HỆ NGƯỜI ĐĂNG"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>