<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Khung tải ảnh -->
        <ImageView
            android:id="@+id/imgUploadPhoto"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:background="#E0E0E0"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_camera"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvPhotoHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nhấn để tải ảnh lên"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imgUploadPhoto" />

        <!-- Tiêu đề đồ vật -->
        <EditText
            android:id="@+id/etItemTitle"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:background="@android:drawable/editbox_background"
            android:hint="Tên đồ vật (VD: Ví da đen, Chìa khóa xe)"
            android:padding="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvPhotoHint" />

        <!-- Loại tin (Bị mất / Nhặt được) -->
        <RadioGroup
            android:id="@+id/radioGroupType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etItemTitle">

            <RadioButton
                android:id="@+id/rbLost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bị mất"
                android:checked="true"
                android:layout_weight="1"/>
            <RadioButton
                android:id="@+id/rbFound"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nhặt được"
                android:layout_weight="1"/>
        </RadioGroup>

        <!-- Mô tả chi tiết -->
        <EditText
            android:id="@+id/etItemDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@android:drawable/editbox_background"
            android:gravity="top|start"
            android:hint="Mô tả chi tiết (Đặc điểm nhận dạng, bên trong có gì...)"
            android:lines="4"
            android:padding="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/radioGroupType" />

        <!-- Địa điểm -->
        <EditText
            android:id="@+id/etItemLocation"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:background="@android:drawable/editbox_background"
            android:hint="Địa điểm (VD: Tòa A, Căn tin...)"
            android:padding="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etItemDescription" />

        <!-- Nút Đăng Tin -->
        <Button
            android:id="@+id/btnSubmitPost"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#B71C1C"
            android:text="Xem trước &amp; Đăng"
            android:textColor="#FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etItemLocation" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>